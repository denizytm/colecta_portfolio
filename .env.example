# İletişim formunun e-posta gönderebilmesi için gerekenler.
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# Vercel'de ise Settings → Environment Variables altına aynı anahtarları girin.

# https://resend.com üzerinden ücretsiz alınır
RESEND_API_KEY=

# Formdan gelen mesajların düşeceği adres
CONTACT_TO=

# Gönderen adresi. Alan adının Resend'de doğrulanmış olması gerekir.
# Doğrulama yapılmadıysa bu satırı boş bırakın; varsayılan test adresi kullanılır.
CONTACT_FROM=
